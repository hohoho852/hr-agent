# Copy to .env and set your own values. Never commit .env.
#
# Generation is provider-open: any OpenAI-compatible chat API works.
# Preferred:
#   LLM_API_KEY=...
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_BASE=https://api.openai.com/v1          # optional; omit for default OpenAI
#
# Examples:
#   OpenAI:     LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
#   Azure OA:   LLM_API_KEY=... LLM_MODEL=<deployment> LLM_API_BASE=https://YOUR.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
#               (or use your gateway's OpenAI-compatible URL)
#   DeepSeek:   LLM_API_KEY=... LLM_MODEL=deepseek-chat LLM_API_BASE=https://api.deepseek.com/v1
#   Local vLLM: LLM_API_KEY=not-needed LLM_MODEL=... LLM_API_BASE=http://localhost:8000/v1
#
# OPENAI_API_KEY / OPENAI_MODEL / OPENAI_API_BASE are accepted as aliases.
# Legacy DEEPSEEK_API_KEY alone still works (implies DeepSeek base + deepseek-chat).

LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com/v1
